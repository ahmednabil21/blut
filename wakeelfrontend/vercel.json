{
  "redirects": [
    {
      "source": "/",
      "destination": "/wakeel/",
      "permanent": false
    },
    {
      "source": "/wakeel/qz/override.crt",
      "destination": "/qz/override.crt",
      "permanent": false
    },
    {
      "source": "/wakeel/qz/digital-certificate.txt",
      "destination": "/qz/digital-certificate.txt",
      "permanent": false
    },
    {
      "source": "/wakeel/qz/install-qz-override.bat",
      "destination": "/qz/install-qz-override.bat",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/wakeel/static/:path*",
      "destination": "/static/:path*"
    },
    {
      "source": "/wakeel/logo192.png",
      "destination": "/logo192.png"
    },
    {
      "source": "/wakeel/logo512.png",
      "destination": "/logo512.png"
    },
    {
      "source": "/wakeel/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/wakeel/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/wakeel/wakeel.mobileconfig",
      "destination": "/wakeel.mobileconfig"
    },
    {
      "source": "/wakeel/qz/:path*",
      "destination": "/qz/:path*"
    },
    {
      "source": "/wakeel/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/wakeel",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).mobileconfig",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-aspen-config"
        }
      ]
    },
    {
      "source": "/qz/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
